   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Scaptomyza pallida - Leaf miner, is a species of insect, a fly of the family Drosophilidae. It is pest of many crops. Insects on cereals.</rdf:li>
    </rdf:Alt>
   </dc:description>
