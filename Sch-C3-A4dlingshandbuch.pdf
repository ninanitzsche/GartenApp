   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Bruchus pisorum - pea weevil, pea beetle and pea seed beetle. It is a species of leaf beetle in the family Chrysomelidae subfamily Bruchinae (bean weevils or seed beetles). It common pest of peas.</rdf:li>
    </rdf:Alt>
   </dc:description>
