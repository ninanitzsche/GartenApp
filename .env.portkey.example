# ============================================
# PORTKEY CONFIGURATION
# ============================================
# For cost optimization and intelligent model routing
# Copy to .env.portkey and fill in your API keys

# Portkey Gateway Configuration
PORTKEY_API_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
PORTKEY_GATEWAY_URL=https://api.portkey.ai/v1

# Claude API Keys (for fallback and direct access)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Cost Tracking
PORTKEY_COST_TRACKING_ENABLED=true
PORTKEY_BUDGET_ALERT_THRESHOLD=80
PORTKEY_MONTHLY_BUDGET=40

# Caching
PORTKEY_CACHE_ENABLED=true
PORTKEY_CACHE_TTL=3600

# Monitoring
PORTKEY_MONITORING_ENABLED=true
PORTKEY_LOG_REQUESTS=true
PORTKEY_LOG_COSTS=true

# Rate Limiting
PORTKEY_RATE_LIMIT_RPM=60
PORTKEY_RATE_LIMIT_TPM=90000

# Development
PORTKEY_DEBUG_MODE=false
PORTKEY_LOG_LEVEL=info
